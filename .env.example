# Environment
ENV=development

# Compute profile: mac for Apple Silicon development, 5090 for production GPU
PROFILE=mac

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=congen
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Application
API_V1_STR=/api/v1
PROJECT_NAME="AI Content Factory"

# Security: set a long random value before exposing the API beyond localhost.
# Required in production for destructive/admin operations and diagnostics.
ADMIN_API_KEY=

# Local/OpenAI-compatible LLM
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
DEFAULT_MODEL=llama3:latest
LLM_DEFAULT_MODEL=llama3:latest

# Optional provider credentials (server-side only; never commit real credentials)
OPENAI_API_KEY=
GEMINI_API_KEY=

# External provider gate: keep false for a private/local-only setup.
ALLOW_EXTERNAL_GENERATION=false

# Higgsfield API
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=
HIGGSFIELD_VIDEO_MODEL=minimax/h3/text-to-video
# Video provider/model: minimax-h3 for local Mac H3, higgsfield-h3 for cloud H3
VIDEO_MODEL=minimax-h3

# MiniMax H3 - low-memory Apple Silicon smoke test
# On your Mac, use the absolute path to the runner and model directory.
H3_COMMAND=/Users/YOUR_USERNAME/minimax-h3-stream-mac/.venv/bin/h3stream
H3_MODEL_DIR=/Users/YOUR_USERNAME/minimax-h3-stream-mac/models
H3_MEMORY_LIMIT_GIB=12.5
