# Environment
ENV=development

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=congen
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Application
API_V1_STR=/api/v1
PROJECT_NAME="AI Content Factory"

# API Keys (Add your actual keys in .env)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=


# MiniMax H3 - low-memory Apple Silicon smoke test
# Install the external runner from:
# https://github.com/AIXF666/minimax-h3-stream-mac
H3_COMMAND=h3stream
H3_MODEL_DIR=models
H3_MEMORY_LIMIT_GIB=12.5
