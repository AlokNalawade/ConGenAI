# Environment
ENV=development

# Compute profile: mac for Apple Silicon development, 5090 for production GPU
PROFILE=mac

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=congen
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Application
API_V1_STR=/api/v1
PROJECT_NAME="AI Content Factory"

# API Keys (Add your actual keys in .env)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# MiniMax H3 - low-memory Apple Silicon smoke test
# On your Mac, use the absolute path to the runner and model directory.
H3_COMMAND=/Users/YOUR_USERNAME/minimax-h3-stream-mac/.venv/bin/h3stream
H3_MODEL_DIR=/Users/YOUR_USERNAME/minimax-h3-stream-mac/models
H3_MEMORY_LIMIT_GIB=12.5
